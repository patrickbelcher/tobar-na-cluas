<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tobar na Cluas</title>

  <!-- Standard favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="favicon/favicon-16x16.png">
  <link rel="shortcut icon" href="favicon/favicon.ico">
  <!-- Apple / iOS -->
  <link rel="apple-touch-icon" sizes="180x180" href="favicon/apple-touch-icon.png">
  <!-- Android / Chrome -->
  <link rel="icon" type="image/png" sizes="192x192" href="favicon/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="favicon/android-chrome-512x512.png">
  <!-- Safari Pinned Tab -->
  <link rel="mask-icon" href="favicon/safari-pinned-tab.svg" color="#000000">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:wght@300;400&display=swap" rel="stylesheet">

  <!-- Bootstrap 5.3.8 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

  <!-- Custom CSS -->
  <link rel="stylesheet" type="text/css" href="css/custom.css">

</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm fixed-top navbar-light" href="#top">
    <div class="container-fluid">
      <!-- Tobar text -->
      <div class="navbar-header">
        <a class="navbar-brand ms-3 me-auto" href="/">Tobar na Cluas</a>

        <!-- Ladle toggle -->
        <button class="navbar-toggler ms-auto me-3" type="button" data-bs-toggle="collapse"
          data-bs-target="#navbarItems" aria-controls="navbarItems" aria-expanded="false"
          aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>

      <!-- Collapsible menu (stacks underneath on small screens) -->
      <div class="collapse navbar-collapse" id="navbarItems">
        <ul class="navbar-nav ms-auto me-3">
          <li class="nav-item">
            <a class="nav-link" href="#about">About</a>
          </li>
        </ul>
      </div>

    </div>
  </nav>

  <main class="container-fluid">
    <% console.log("EJS mixes:", mixes); %>
    <% mixes.forEach(mix=> { %>
      <section class="ms-3 me-3 pb-5 release-section">

        <div class="mix-container">
          <div class="mix-image">

            <div 
              class="image-hover-wrap" 
              data-id="<%= mix.id %>">
              
              <img src="/img/<%= mix.base %>.<%= mix.formats.image %>" alt="<%= mix.title %>">

              <!-- Overlay -->
              <div class="image-overlay">
                <img class="play-icon" src="/icons/play.svg" alt="Play">
              </div>
            </div>
          </div>

          <div class="mix-text">
            <h3>
              <%= mix.id %> : <%= mix.title %>
            </h3>

            <% mix.tracklist.forEach(line=> { %>
              <p>
                <%= line %>
              </p>
              <% }) %>
          </div>
        </div>

      </section>
      <% }) %>
  </main>

  <!-- custom audio player-->
  <footer id="footer-player">

    <div class="player-container my-5">
      <!-- Play/Pause button-->
      <button id="play-btn">
        <!-- SVG button icon sizing-->
        <svg id="player-icon" viewBox="0 0 100 100" width="30" height="30"></svg>
      </button>

      <!-- Elapsed time -->
      <span id="elapsed-time">0:00</span>

      <!-- Seek bar -->
      <div class="progress-wrapper">
        <div id="progress-bar"></div>
      </div>

      <!-- Total duration -->
      <span id="total-time">0:00</span>
    </div>

  </footer>

  
  <!-- Navbar SVG Icon-->
  <script src="./js/navbar-icons.js"></script>
  <!-- Audio Player JS-->
  <script type="module" src="js/player.js"></script>
  <!-- Mix data -->
  <script>
  window.mixes = <%- JSON.stringify(mixes) %>;
  console.log(window.mixes); // Array of all mixes
  </script>

  <!-- Bootstrap 5.3.8 -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>

</body>

</html>