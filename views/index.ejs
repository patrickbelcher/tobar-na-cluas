<main class="container-fluid">
  <% console.log("EJS mixes:", mixes); %>

    <% mixes.forEach(mix=> { %>
      <section class="ms-3 me-3 pb-5 release-section">

        <div class="mix-container">
          <div class="mix-image">

            <div class="image-hover-wrap" data-id="<%= mix.id %>">

              <!-- Title Overlay -->
              <div class="mix-title-overlay">
                <h3>
                  <%= mix.id %> : <%= mix.title %>
                </h3>
              </div>

              <img src="/img/<%= mix.base %>.<%= mix.formats.image %>" alt="<%= mix.title %>">

              <!-- Overlay -->
              <div class="image-overlay">
                <img class="play-icon" src="/icons/play_circle.svg" alt="Play">
              </div>
            </div>
          </div>

          <div class="mix-text">
            <% mix.tracklist.forEach(line=> { %>
              <p>
                <%= line %>
              </p>
              <% }) %>
          </div>
        </div>

      </section>
      <% }) %>

        <!-- Pass mixes to global JS -->
        <script>
          window.mixes = <%- JSON.stringify(mixes) %>;
          console.log('Mixes JSON:', window.mixes);
        </script>

</main>