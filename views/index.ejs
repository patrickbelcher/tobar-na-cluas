<% console.log("EJS mixes:", mixes); %>

  <% Object.values(mixes).forEach(mix => { %>
    <section class="mix-section">

      <div class="mix-container">

        <div class="mix-image">

          <div class="mix-image-wrap">
            <!-- Title Overlay -->
            <div class="mix-title-overlay">
              <a href="/mix/<%= mix.base %>" class="mix-title-link" data-spa>
                <h3>
                  <%= mix.who %> : <%= mix.title %>
                </h3>
              </a>
            </div>

            <div class="mix-audio-control-zone" data-id="<%= mix.base %>">
              <img src="/mixes/<%= mix.base %>/<%= mix.image %>" alt="<%= mix.title %>">
              <!-- Overlay -->
              <div class="image-overlay">
                <img class="play-icon" src="/icons/play_circle.svg" alt="Play">
              </div>
            </div>
          </div>

        </div>

        <div class="mix-text">
          <% mix.tracklist.forEach(line=> { %>
            <p>
              <%= line %>
            </p>
            <% }) %>
        </div>

      </div>

    </section>

    <!-- <div class="zig-zag-line"></div> -->

    <% }) %>
