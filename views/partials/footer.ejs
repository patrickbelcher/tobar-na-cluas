<!-- Audio Player-->
<footer id="footer-player" class="sticky-bottom">
 
    <div class="player-container">

      <div class="playing-details">
        <div id="current-track">playing : <span id="player-mix-title"></span> </div>
      </div>

      <div class="player-controls">
        <!-- Play/Pause button-->
        <button id="play-btn" aria-label="Play or Pause">
          <!-- SVG button icon sizing-->
          <svg id="player-icon"></svg>
        </button>

        <!-- Elapsed time -->
        <span id="elapsed-time">0:00</span>

        <!-- Seek bar -->
        <div class="progress-wrapper">
          <div id="progress-bar"></div>
        </div>

        <!-- Total duration -->
        <span id="total-time">0:00</span>

        <!-- File Format -->
        <button id="format-toggle" class="format-btn">MP3</button>

        <!-- Download -->
        <button id="download-btn" class="download-btn" aria-label="Download"></button>

      </div>
    </div>

</footer>