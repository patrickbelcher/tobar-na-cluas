<!-- Audio Player-->
<footer id="footer-player" aria-label="Audio player">

  <div class="player-container">

    <div class="playing-details">
      <div id="current-track">playing : <span id="player-mix-title"></span> </div>
    </div>

    <div class="player-controls">
      <!-- Play/Pause button-->
      <button id="play-btn" aria-label="Play">
        <!-- SVG button icon sizing-->
        <svg id="player-icon" aria-hidden="true"></svg>
      </button>

      <!-- Elapsed time (visual only: the slider tells screen readers) -->
      <span id="elapsed-time" aria-hidden="true">0:00</span>

      <!-- Seek slider: keyboard and screen-reader operable; disabled until a mix loads -->
      <input type="range" id="seek" class="seek" min="0" max="0" step="any" value="0" aria-label="Seek"
        aria-valuetext="No mix loaded" disabled>

      <!-- Total duration (visual only) -->
      <span id="total-time" aria-hidden="true">0:00</span>
      <span id="total-time">0:00</span>

      <!-- File Format -->
      <button id="format-toggle" class="format-btn">MP3</button>

      <!-- Download -->
      <button id="download-btn" class="download-btn" aria-label="Download MP3"></button>

    </div>
  </div>

</footer>