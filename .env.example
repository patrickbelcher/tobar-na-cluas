# Copy this file to .env and fill in the values. Never commit .env.

# Port the Express server listens on
PORT=3000

# Public address of the site (canonical links, link previews, sitemap)
SITE_URL=https://tobarnacluas.ie

# Cloudflare R2 bucket holding the mixes (R2 → Manage API tokens in the Cloudflare dashboard)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public address the bucket's files are served from
CDN_BASE_URL=https://cdn.tobarnacluas.ie